digraph G { rankdir=TB; bgcolor="white"; pad=0.15; nodesep=0.35; ranksep=0.45; newrank=true; 
 node [shape=box, style="rounded,filled", fontname="Liberation Serif", fontsize=13, fontcolor="#1A1A1A", penwidth=1.3, margin="0.18,0.08"];
 edge [color="#4A5563", penwidth=1.4, arrowsize=0.8, fontname="Liberation Serif", fontsize=11, fontcolor="#333333"];
 tw [label="TweetEval\nsocial media · three-class", fillcolor="#D6E4F2", color="#2F5C8A"];
 n [label="External data never influences\nmodel or feature selection", fillcolor="#FFF8E1", color="#9C8F6A", shape=note, style="filled"];
 dev [label="Development\nvalidation-based model and feature selection", fillcolor="#E4E8EE", color="#5A6A7E"];
 se [label="SemEval-2014\nreview text · three-class", fillcolor="#D3ECE6", color="#2E7D6E"];
 lt [label="One locked test evaluation\nRQ1 · RQ2 · RQ3", fillcolor="#D6E4F2", color="#2F5C8A"];
 s140 [label="Sentiment140\nsocial media · binary", fillcolor="#FBE7C2", color="#A8720F"];
 ds [label="Domain / task-shift\nstress evaluation (RQ4)", fillcolor="#FFFFFF", color="#7F8C9A"];
 br [label="Binary external\nrobustness evaluation (RQ4)", fillcolor="#FFFFFF", color="#7F8C9A"];
 tw -> dev [];
 n -> dev [style=dashed, dir=none, color="#A33A4B"];
 dev -> lt [];
 lt -> ds [];
 lt -> br [];
 se -> ds [style=dashed];
 s140 -> br [style=dashed];
