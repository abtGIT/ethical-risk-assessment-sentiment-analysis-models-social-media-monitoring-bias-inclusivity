digraph G { rankdir=TB; bgcolor="white"; pad=0.15; nodesep=0.35; ranksep=0.45; newrank=true; 
 node [shape=box, style="rounded,filled", fontname="Liberation Serif", fontsize=13, fontcolor="#1A1A1A", penwidth=1.3, margin="0.18,0.08"];
 edge [color="#4A5563", penwidth=1.4, arrowsize=0.8, fontname="Liberation Serif", fontsize=11, fontcolor="#333333"];
 a [label="Social media users\n5.66 billion user identities", fillcolor="#D6E4F2", color="#2F5C8A"];
 b [label="User-generated content\nslang, emoji, sarcasm", fillcolor="#FFFFFF", color="#7F8C9A"];
 c [label="Automated sentiment\nmonitoring", fillcolor="#E4E8EE", color="#5A6A7E"];
 d [label="Sentiment classifier\nnegative / neutral / positive", fillcolor="#D3ECE6", color="#2E7D6E"];
 e [label="Aggregate summary\nsingle accuracy figure reported", fillcolor="#FBE7C2", color="#A8720F"];
 f [label="Organisational\ndecisions", fillcolor="#D6E4F2", color="#2F5C8A"];
 n1 [label="Performance may differ\nacross writing styles", fillcolor="#FFF8E1", color="#9C8F6A", shape=note, style="filled"];
 n2 [label="Aggregate scores may conceal\nsubgroup differences", fillcolor="#FFF8E1", color="#9C8F6A", shape=note, style="filled"];
 a -> b [];
 b -> c [];
 c -> d [];
 d -> e [];
 e -> f [];
 n1 -> d [style=dashed, dir=none, color="#A33A4B"];
 n2 -> e [style=dashed, dir=none, color="#A33A4B"];
 {rank=same; n1; d;}
 {rank=same; n2; e;}
}