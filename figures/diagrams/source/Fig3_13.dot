digraph G { rankdir=TB; bgcolor="white"; pad=0.15; nodesep=0.35; ranksep=0.45; newrank=true; 
 node [shape=box, style="rounded,filled", fontname="Liberation Serif", fontsize=13, fontcolor="#1A1A1A", penwidth=1.3, margin="0.18,0.08"];
 edge [color="#4A5563", penwidth=1.4, arrowsize=0.8, fontname="Liberation Serif", fontsize=11, fontcolor="#333333"];
 s1 [label="Stage 1  Protocol, data\nand subgroup freeze", fillcolor="#D6E4F2", color="#2F5C8A"];
 s2 [label="Stage 2  Controlled baseline\nmodel comparison", fillcolor="#D6E4F2", color="#2F5C8A"];
 s3 [label="Stage 3  Feature comparison,\noptimisation and pipeline lock", fillcolor="#D6E4F2", color="#2F5C8A"];
 n [label="Pipeline locked:\ntest split opened once", fillcolor="#FFF8E1", color="#9C8F6A", shape=note, style="filled"];
 s4 [label="Stage 4  Locked TweetEval\ntest evaluation", fillcolor="#D3ECE6", color="#2E7D6E"];
 s5 [label="Stage 5  RQ1 subgroup\nperformance audit", fillcolor="#D3ECE6", color="#2E7D6E"];
 s6 [label="Stage 6  RQ2 five-model\ndisparity audit", fillcolor="#D3ECE6", color="#2E7D6E"];
 s7 [label="Stage 7  RQ3 errors,\nconfidence and XAI", fillcolor="#D3ECE6", color="#2E7D6E"];
 s8 [label="Stage 8  RQ4 external\nrobustness", fillcolor="#FBE7C2", color="#A8720F"];
 s9 [label="Stage 9  Multi-dimensional\nethical-risk evidence synthesis", fillcolor="#E4E8EE", color="#5A6A7E"];
 s1 -> s2 [];
 s2 -> s3 [];
 s3 -> s4 [];
 s3 -> n [style=dashed, dir=none, color="#A33A4B"];
 s4 -> s5 [];
 s4 -> s6 [];
 s4 -> s7 [];
 s4 -> s8 [];
 s5 -> s7 [style=invis]; s6 -> s8 [style=invis];
 s5 -> s9 [];
 s6 -> s9 [];
 s7 -> s9 [];
 s8 -> s9 [];
 {rank=same; s3; n;}
 {rank=same; s5; s6;}
 {rank=same; s7; s8;}
}