digraph G { rankdir=TB; bgcolor="white"; pad=0.15; nodesep=0.35; ranksep=0.45; newrank=true; nodesep=0.15;
 node [shape=box, style="rounded,filled", fontname="Liberation Serif", fontsize=18, fontcolor="#1A1A1A", penwidth=1.3, margin="0.18,0.08"];
 edge [color="#4A5563", penwidth=1.4, arrowsize=0.8, fontname="Liberation Serif", fontsize=16, fontcolor="#333333"];
 t [label="TweetEval test post (raw text, N = 12,284)", fillcolor="#D6E4F2", color="#2F5C8A"];
 r [label="Frozen precedence rule, once per post\nsarcasm → emoji → slang\n→ reference-unmarked → other", fillcolor="#E4E8EE", color="#5A6A7E"];
 s [label="Sarcasm-indicated\nN = 14\nirony hashtag or\nstock ironic phrase\n“SORRY, HARRY...\nI’M LEAVING YOU FOR\nYOUR TWIN: MARCEL\n#JK” (neutral)", fillcolor="#F6D5DA", color="#A33A4B"];
 e [label="Emoji-heavy\nN = 710\nemoji / word > 0.05\n“Thanksgiving food is\nbetter the second day\n[turkey][heart-eyes]”\n(positive)", fillcolor="#D3ECE6", color="#2E7D6E"];
 sl [label="Slang-heavy\nN = 60\n51-term lexicon,\nslang / word > 0.10\n“Going to see\n#FantasticBeasts\nand I am LIT” (positive)", fillcolor="#FBE7C2", color="#A8720F"];
 ru [label="Reference-unmarked\nN = 10,388\nno focal marker, ≥ 8 words\n“Like Grayson Allen, Adam\nis now operating at\n50 percent.” (neutral)", fillcolor="#D6E4F2", color="#2F5C8A"];
 ot [label="Other\nN = 1,112\nno focal marker,\n< 8 words\n“This is great!”\n(positive)", fillcolor="#EDEDED", color="#8A8A8A"];
 n [label="Interpretation rule\nN ≥ 30 stable quantitative\nN < 30 exploratory only", fillcolor="#FFF8E1", color="#9C8F6A", shape=note, style="filled"];
 t -> r [];
 r -> s [];
 r -> e [];
 r -> sl [];
 r -> ru [];
 r -> ot [];
 e -> ru [style=invis]; sl -> ot [style=invis];
 ot -> n [style=dashed, dir=none, color="#A33A4B"];
 {rank=same; s; e; sl;}
 {rank=same; ru; ot; n;}
}